  },
  "x-utekos-characterized-against": "97a0a4538f9682a2b210e50b770ce59f826b42ac",
  "x-utekos-binding-note": "No protocol binding is declared because the official AsyncAPI bindings catalog has no Vercel Queue binding. Kafka, AMQP, and IBM MQ bindings would be false representations.",
  "x-utekos-delivery-note": "Vercel Queue delivery is at least once. The publisher idempotency key is deduplicated for min(retention, 24 hours), so consumers and the persisted outbox claim remain the durable idempotency boundary."
}
