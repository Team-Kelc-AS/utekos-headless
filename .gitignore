# See https://git-scm.com/docs/gitignore for pattern semantics.

### Next.js and package managers ###
/.pnp
.pnp.js
.pnp.*
**/node_modules/
/alpha
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Tests, builds, and generated types
/coverage/
/.next/
/out/
/build/
*.tsbuildinfo
next-env.d.ts

# Local environment files and secret stores
.env
.env.*
.env.mcp.local
!.env.example
!.env.*.example
/env.local
/.npmrc
/.yarnrc.local.yml
/.vercel/

# Certificates, private keys, infrastructure state, and local databases
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.tfvars
*.tfvars.json
*.tfstate
*.tfstate.*
/.terraform/
*.sqlite
*.sqlite-*

# Git-only local agent/provider state. These paths remain readable to agents
# because they are intentionally not listed in .cursorignore.
/.codex/config.toml
/.codex/.env
/.codex/auth.json
/.codex/screenshots/
/.agent/
/.agent-artifacts/
/.worktrees/
/.playwright-cli/
**/.playwright-cli.json
/supabase/.branches/
/supabase/.temp/
/.development-data/

# Local-only agent, operations, evidence, and editor sources. These stay on
# disk for local agents but are never committed or sent through GitHub.
# Exception: Cursor Cloud clones GitHub only, so environment.json and the
# install script must be tracked. MCP configs and debug logs stay ignored.
/.agent/
/.agents/
/.codex/
/.cursor/*
!/.cursor/environment.json
!/.cursor/cloud-install.sh
/.github/
/.playwright-cli/
/.superpowers/
/.vscode/
/docs/
/output/
/AGENTS.md
/CANONICAL_EVENTS.md
/COMMERCIAL_INTELLIGENCE_PLAN.md
/DEPLOYMENT.md
/DEVELOPMENT.md
/EVENT_CATALOG.md
/FLOW.md
/NEXT.md
/PLAN.md
/draft.md
/chatgpt-app-submission.json
/skills-lock.json
/test.json
/shadcn-extension.json
/.gcloudignore
/.mcp.json
/types/codex-log.md

# Local provider credentials (templates/examples stay commit-safe)
/.user/files/marketing/meta/signals/
/src/api/lib/cloud-credentials/*.json
!/src/api/lib/cloud-credentials/*.example.json
/credentials.json
/token.json
/service-account.json
/*.service-account.json
/*oauth-credentials*.json
/*tag-manager-credentials*.json
**/application_default_credentials.json

# Generated MCP client configurations may interpolate local credentials.
# Their committed templates live in utekos-platform-tools.
/mcp.json
/.vscode/mcp.json
/.cursor/mcp.json
/.cursor/mcp.remote.json
/.devcontainer/
/public-scan-result.md
/scripts/public/scan-unused-assets.ts

# Local editor and analysis output
/knip
/knip.json
.prettierignore
/prettierignore
/prettierignore.json
/.gemini/
/gemini-status
/summary
summary
*/playwright-mcp/

# Accidental local SDK and tooling trees
/merchant-api-samples/
/gcloud components install alpha beta skaffold minikube kubectl gke-gcloud-auth-plugin/
/output/
/.vc-config.json
/types/codex-log.md

# OS and debug output
.DS_Store
.devtools/
.hintrc
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.vercel
/.swc
