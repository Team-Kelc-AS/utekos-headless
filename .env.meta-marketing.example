# Direct Meta Marketing API and Catalog API, server-side only.
# Reuse the existing CAPI_Master_User system-user token. Do not create
# another Meta user or token for this integration.
META_SYSTEM_USER_TOKEN=
META_APP_SECRET=

# Non-secret asset pins. The runtime rejects values that point elsewhere.
META_APP_ID=1154247890253046
META_BUSINESS_ID=538548380599665
META_AD_ACCOUNT_ID=772268237116474
META_CATALOG_ID=690208780604782
META_PAGE_ID=101843722195040
META_COMMERCE_ACCOUNT_ID=810470868471691

# Phase 1 is read-only. The runtime rejects a connection check if this is true.
META_MARKETING_API_MUTATIONS_ENABLED=false
