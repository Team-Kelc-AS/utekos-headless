# Vipps Login stays fail-closed until the sales unit and exact callback URI
# have been verified in the Vipps MobilePay business portal.
VIPPS_LOGIN_ENABLED=false
VIPPS_ENVIRONMENT=test
VIPPS_LOGIN_REDIRECT_ORIGIN=http://localhost:3000

# Generate a dedicated 32-byte base64 value. Never reuse or commit a real key.
VIPPS_LOGIN_SESSION_SECRET=

# Login reuses the selected sales unit's existing environment-specific client.
VIPPS_TEST_CLIENT_ID=
VIPPS_TEST_CLIENT_SECRET=
