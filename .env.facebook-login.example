# Facebook Login for Meta-origin visitors. Preview-only: production
# hosts never activate the prompt, even if this flag is true.
# Keep the app secret and identity key server-side in Vercel.
FACEBOOK_LOGIN_APP_ID=
FACEBOOK_LOGIN_APP_SECRET=
FACEBOOK_LOGIN_ENABLED=false
# Generate a dedicated 32-byte base64 key, for example with:
# openssl rand -base64 32
FACEBOOK_LOGIN_IDENTITY_KEY=
FACEBOOK_LOGIN_REDIRECT_ORIGIN=https://utekos.no
